<odoo>
    <record id="review_wizard_form" model="ir.ui.view">
        <field name="name">trustgate.review.wizard.form</field>
        <field name="model">trustgate.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Payment">
                <group><field name="request_id"/><field name="note"/></group>
                <footer>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"/>
                    <button name="action_reject" type="object" string="Reject"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_review_wizard" model="ir.actions.act_window">
        <field name="name">Review Payment</field>
        <field name="res_model">trustgate.review.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="payment_request_list" model="ir.ui.view">
        <field name="name">trustgate.payment.request.list</field>
        <field name="model">trustgate.payment.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'review'" decoration-success="state == 'approved'">
                <field name="name"/><field name="partner_id"/><field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="risk_score"/><field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="payment_request_form" model="ir.ui.view">
        <field name="name">trustgate.payment.request.form</field>
        <field name="model">trustgate.payment.request</field>
        <field name="arch" type="xml">
            <form string="Payment Review">
                <header>
                    <button name="action_submit" type="object" string="Assess Request" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="%(action_review_wizard)d" type="action" string="Review" context="{'default_request_id': id}" groups="trustgate.group_reviewer" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Payment details">
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="bank_id" domain="[('partner_id', '=', partner_id)]" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="requested_by"/><field name="submitted_at"/>
                        </group>
                        <group string="Risk assessment">
                            <field name="risk_score" widget="trustgate_score"/>
                            <field name="risk_reasons"/><field name="bank_last_four"/>
                            <field name="reviewed_by"/><field name="reviewed_at"/>
                            <field name="review_note" readonly="True"/>
                        </group>
                    </group>
                    <p class="text-muted">This request records an internal review. It does not send or block accounting payments.</p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_payment_requests" model="ir.actions.act_window">
        <field name="name">Payment Reviews</field>
        <field name="res_model">trustgate.payment.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_trustgate" name="TrustGate" groups="trustgate.group_operator" sequence="50"/>
    <menuitem id="menu_payment_requests" name="Payment Reviews" parent="menu_trustgate" action="action_payment_requests"/>
</odoo>
